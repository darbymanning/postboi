---
// The public half of the VAPID pair — public by definition; the private half stays on
// the server and signs every send. `bunx postboi init --push` mints the pair. It rides
// to the client on a data attribute because Astro's bundled <script> below can't see
// server env (and define:vars would un-bundle it, breaking the npm import).
const key = import.meta.env.VAPID_PUBLIC_KEY ?? ""
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Web Push</title>
		<style>
			main {
				max-width: 32rem;
				margin: 4rem auto;
				padding: 0 1rem;
				font-family: system-ui, sans-serif;
			}
			button {
				font: inherit;
				padding: 0.5rem 1rem;
				margin-right: 0.5rem;
			}
		</style>
	</head>
	<body>
		<main data-key={key}>
			<h1>Web Push</h1>
			{
				key ? (
					<>
						<p>
							Subscribe this browser, then have the server push to it — close the tab
							first if you want proof it works with the site gone.
						</p>
						<button id="toggle" disabled>
							Subscribe
						</button>
						<button id="test" disabled>
							Send me one
						</button>
						<p id="status" />
					</>
				) : (
					<p>
						No VAPID keys yet — run <code>bunx postboi init --push</code> and restart.
					</p>
				)
			}
		</main>

		<script>
			import { push_controller } from "postboi/push"

			// The whole toggle state machine lives in the controller — this script only
			// wires it to the DOM. No framework required: subscribe() on the controller
			// is a plain observable.
			const key = document.querySelector("main")?.dataset.key
			const toggle = document.getElementById("toggle") as HTMLButtonElement | null
			const test = document.getElementById("test") as HTMLButtonElement | null
			const status = document.getElementById("status")

			if (key && toggle && test && status) {
				const push = push_controller({ key, register: "/push/subscriptions" })

				push.subscribe((state) => {
					toggle.textContent = state.on ? "Unsubscribe" : "Subscribe"
					toggle.disabled = state.busy
					test.disabled = !state.on || state.busy
					if (state.reason) status.textContent = state.reason
				})

				toggle.addEventListener("click", () => {
					void (push.now().on ? push.disable() : push.enable())
				})

				test.addEventListener("click", async () => {
					const response = await fetch("/push/subscriptions", { method: "PUT" })
					const { sent } = await response.json()
					status.textContent = sent
						? "sent — check your notifications"
						: "nothing subscribed on the server"
				})
			}
		</script>
	</body>
</html>
